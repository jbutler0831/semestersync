# Copy to .env for local development. Never commit .env. Production uses different values,
# set on the server only (see README "Production").
APP_ENV=development
DATABASE_URL=postgresql+psycopg://semestersync:dev-only-password@localhost:5432/semestersync
# Generate your own: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
TOKEN_PEPPER=replace-me-with-at-least-32-random-characters
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=SemesterSync <no-reply@localhost>
