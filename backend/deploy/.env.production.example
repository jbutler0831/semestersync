# Production settings. Copy to .env.production ON THE SERVER ONLY and fill in real values.
# Never commit .env.production, and never reuse development values here.

# The API's address, e.g. api.semestersync.app. Its DNS must point at this server before starting Caddy.
API_DOMAIN=
# python3 -c "import secrets;print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# python3 -c "import secrets;print(secrets.token_urlsafe(48))"   (changing it later signs everyone out)
TOKEN_PEPPER=

# Outgoing email, from your email provider's SMTP settings.
EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=SemesterSync <no-reply@your-domain>

# Encrypted backups (deploy/backup.sh): the public key from `age-keygen`. Keep the private key off this server.
BACKUP_AGE_RECIPIENT=
